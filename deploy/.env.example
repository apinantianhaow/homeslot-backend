# Copy to `.env` and fill in. Generate secrets with: openssl rand -base64 32
PUBLIC_HOST=homeslot.example.com

DB_PASSWORD=
SERVICE_SECRET=
EMAIL_PEPPER=
JWT_PRIVATE_KEY=
JWT_REFRESH_PEPPER=

# Optional: SMTP for verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: Cloudflare Tunnel token (docker compose --profile tunnel up -d).
CLOUDFLARE_TUNNEL_TOKEN=
